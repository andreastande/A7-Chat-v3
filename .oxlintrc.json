{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "nextjs", "react"],
  "rules": {
    "typescript/consistent-type-imports": "warn"
  },
  "settings": {
    "react": {
      "linkComponents": [{ "name": "Link", "attribute": "href" }],
      "version": "19.2.3"
    }
  },
  "env": {
    "builtin": true
  }
}
